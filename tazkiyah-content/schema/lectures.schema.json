{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tazkiyah lecture file",
  "description": "data/lectures/<speakerId>.json. Lecture, media and series objects reject unknown keys so that a typo (e.g. \"durationsec\", \"publishAt\") fails validation instead of being silently dropped by the app. Add new fields here when you add them to the data.",
  "type": "object",
  "required": ["speakerId", "lectures"],
  "properties": {
    "speakerId": {
      "type": "string",
      "pattern": "^speaker-[0-9]{3,}$"
    },
    "lectures": {
      "type": "array",
      "items": { "$ref": "#/$defs/lecture" }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "lecture": {
      "type": "object",
      "required": ["id", "title", "categoryIds", "media", "addedAt"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Never changes and is never reused (favorites, history and resume positions are tied to it).",
          "type": "string",
          "pattern": "^spk[0-9]{3,}-[0-9]{4,}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "categoryIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "media": { "$ref": "#/$defs/media" },
        "durationSec": {
          "description": "Length in seconds.",
          "type": "integer",
          "minimum": 1
        },
        "publishedAt": { "$ref": "#/$defs/date" },
        "addedAt": { "$ref": "#/$defs/date" },
        "series": { "$ref": "#/$defs/series" }
      }
    },
    "media": {
      "oneOf": [
        { "$ref": "#/$defs/youtubeMedia" },
        { "$ref": "#/$defs/audioMedia" },
        { "$ref": "#/$defs/videoMedia" }
      ]
    },
    "youtubeMedia": {
      "type": "object",
      "required": ["type", "videoId"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "youtube" },
        "videoId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{11}$"
        },
        "startSec": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "audioMedia": {
      "type": "object",
      "required": ["type", "url"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "audio" },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "mimeType": {
          "type": "string",
          "pattern": "^audio/[A-Za-z0-9.+-]+$"
        }
      }
    },
    "videoMedia": {
      "type": "object",
      "required": ["type", "url"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "video" },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "mimeType": {
          "type": "string",
          "pattern": "^video/[A-Za-z0-9.+-]+$"
        }
      }
    },
    "series": {
      "type": "object",
      "required": ["id", "title", "part"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "part": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
