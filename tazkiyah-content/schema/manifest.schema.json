{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tazkiyah content manifest",
  "description": "manifest.json — the first file the app reads. Generated by scripts/build_manifest.py; do not edit by hand.",
  "type": "object",
  "required": ["schemaVersion", "minAppVersionCode", "dataVersion", "updatedAt", "files"],
  "properties": {
    "schemaVersion": {
      "description": "Bumped only on a breaking format change.",
      "type": "integer",
      "minimum": 1
    },
    "minAppVersionCode": {
      "description": "Apps with a lower versionCode show 'update the app' instead of syncing.",
      "type": "integer",
      "minimum": 1
    },
    "dataVersion": {
      "description": "Bumped by 1 on every content change.",
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "description": "UTC timestamp, YYYY-MM-DDTHH:MM:SSZ.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    },
    "changelog": {
      "description": "Short Bengali note shown in the app's update banner.",
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^data/[A-Za-z0-9._/-]+\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
